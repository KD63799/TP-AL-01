{
  "name": "archi-reservation-starter",
  "version": "1.0.0",
  "description": "Starter du module Architecture logicielle (4ESGI AL) : réservation de ressources partagées",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "test:s4": "vitest run --dir test/s4",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid",
    "depcruise:modules": "depcruise src --config .dependency-cruiser.cjs --collapse \"^src/(shared/[^/]+|[^/]+)\" --output-type text",
    "test:demarrage": "vitest run test/demarrage.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "amqplib": "^2.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.4",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.4.0",
    "typescript": "~6.0.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
